<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MediaBrowser.Common" Version="4.9.0.52-beta" />
        <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.0.52-beta" />
        <!-- Only for the compiler: Emby ships its own copy, and the response writer is one of its types -->
        <PackageReference Include="System.IO.Pipelines" Version="6.0.0" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Emby.GitHubRepoPluginInstall.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="ThumbImage.jpg"/>
        <EmbeddedResource Include="ThumbImage.jpg"/>
        <EmbeddedResource Include="..\DefaultRegistry\plugins.json">
            <Link>DefaultRegistry\plugins.json</Link>
        </EmbeddedResource>
    </ItemGroup>
</Project>
